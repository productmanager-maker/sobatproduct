bot.on('callback_query', async (query) => {
  const data = query.data || '';
  const chatId = query.message?.chat?.id;
  const fromId = query.from?.id;
  const messageId = query.message?.message_id;

  if (!chatId || !fromId || !messageId) return;

  if (data.startsWith('muvview:')) {
    await bot.answerCallbackQuery(query.id).catch(() => {});

    if (data === 'muvview:cancel') {
      await bot.editMessageText('❎ Lihat data dibatalkan.', { chat_id: chatId, message_id: messageId }).catch(() => {});
      return;
    }

    if (data.startsWith('muvview:pick-board-summary:')) {
      const orgId = data.replace('muvview:pick-board-summary:', '');
      const lookup = await getMuvBoards(fromId, query.from?.username || '', { orgId });
      const orgName = buildOrgChoices(lookup.data || {}).find(org => org.id === orgId)?.name
        || lookup.data?.boards?.[0]?.workspace?.name
        || 'organisasi ini';
      if (!lookup.ok || !lookup.data.boards?.length) {
        await bot.editMessageText(`Belum ada board yang bisa lo lihat di ${orgName}.`, {
          chat_id: chatId,
          message_id: messageId,
        }).catch(() => {});
        return;
      }
      await bot.editMessageText(`Pilih board di ${orgName}:`, {
        chat_id: chatId,
        message_id: messageId,
        reply_markup: {
          inline_keyboard: [
            ...chunkButtons(lookup.data.boards.slice(0, 20).map(board => ({
              text: truncateLabel(`${board.workspace?.name || 'Workspace'} · ${board.name}`, 34),
              callback_data: `muvview:board-summary:${board.id}`,
            })), 1),
            [{ text: 'Batal', callback_data: 'muvview:cancel' }],
          ],
        },
      }).catch(() => {});
      return;
    }

    if (data.startsWith('muvview:board-summary:')) {
      const boardId = data.replace('muvview:board-summary:', '');
      const res = await getMuvCommand('board-summary', fromId, query.from?.username || '', { boardId });
      if (!res.ok) {
        await bot.editMessageText(`Gagal ambil summary board: ${res.data?.error || 'unknown error'}`, { chat_id: chatId, message_id: messageId }).catch(() => {});
        return;
      }
      await bot.editMessageText(formatBoardSummary(res.data.board), {
        chat_id: chatId,
        message_id: messageId,
        parse_mode: 'Markdown',
      }).catch(() => {});
      return;
