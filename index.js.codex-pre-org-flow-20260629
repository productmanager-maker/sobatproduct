function jakartaDateParts(offsetDays = 0) {
  const base = new Date(Date.now() + offsetDays * 24 * 60 * 60 * 1000);
  const fmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Jakarta',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
  const parts = fmt.formatToParts(base);
  const get = type => parts.find(p => p.type === type)?.value || '';
  return { year: get('year'), month: get('month'), day: get('day') };
}

function duePresetToIso(preset) {
  if (preset === 'none') return '';
  const offset = preset.startsWith('tomorrow') ? 1 : 0;
  const { year, month, day } = jakartaDateParts(offset);
  if (preset.endsWith('09')) return `${year}-${month}-${day}T09:00:00+07:00`;
  return `${year}-${month}-${day}T17:00:00+07:00`;
}

function formatDueLabel(isoString) {
  if (!isoString) return '';
  return new Intl.DateTimeFormat('id-ID', {
    timeZone: 'Asia/Jakarta',
    day: 'numeric',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  }).format(new Date(isoString));
}

