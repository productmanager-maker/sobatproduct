function buildOrgChoices(payload = {}) {
  if (Array.isArray(payload.orgs) && payload.orgs.length) {
    return payload.orgs
      .map(org => ({
        id: org.orgId || org.id || '',
        name: org.orgName || org.name || 'Organisasi',
        count: org.count || org.boardCount || 0,
        role: org.role || '',
      }))
      .filter(org => org.id && org.name)
      .sort((a, b) => a.name.localeCompare(b.name, 'id'));
  }

  const orgs = new Map();
  for (const board of payload.boards || []) {
    const orgId = board.workspace?.orgId;
    const name = board.workspace?.name;
    if (!orgId || !name) continue;
    if (!orgs.has(orgId)) orgs.set(orgId, { id: orgId, name, count: 0 });
    orgs.get(orgId).count += 1;
  }
  return Array.from(orgs.values()).sort((a, b) => a.name.localeCompare(b.name));
}

