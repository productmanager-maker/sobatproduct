function truncateLabel(text, max = 32) {
  return text.length > max ? `${text.slice(0, max - 1)}…` : text;
}

function escMd(text = '') {
  return String(text).replace(/[_*[\]()~`>#+=|{}.!-]/g, '\\$&');
}

function formatBoardGroups(boards) {
  const groups = new Map();
  for (const board of boards || []) {
