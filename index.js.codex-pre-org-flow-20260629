            2
          ),
          [{ text: 'Batal', callback_data: 'muv:cancel' }],
        ],
      },
    });
  }

  setNewTaskSession(msg.chat.id, msg.from.id, {
    orgs,
    stage: 'pick-org',
  });

  await bot.sendMessage(msg.chat.id, 'Pilih organisasi dulu:', {
    reply_markup: {
      inline_keyboard: [
        ...chunkButtons(orgs.map(org => ({
          text: org.name,
