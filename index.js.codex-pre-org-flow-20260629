  return Array.from(groups.entries())
    .map(([workspace, names]) => `*${escMd(workspace)}*\n${names.map(name => `• ${escMd(name)}`).join('\n')}`)
    .join('\n\n');
}

function formatCardsList(cards, { emptyText, title }) {
  if (!cards?.length) return emptyText;
  const lines = cards.map((card, index) => {
    const due = card.dueDate ? ` · ⏰ ${formatDueLabel(card.dueDate)}` : '';
    return `${index + 1}. *${escMd(card.title)}*\n   ${escMd(card.workspaceName)} → ${escMd(card.boardName)} / ${escMd(card.listName)}${due}`;
  });
  return `${title}\n\n${lines.join('\n\n')}`;
}

