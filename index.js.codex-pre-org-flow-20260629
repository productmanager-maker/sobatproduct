      const res = await getMuvCommand('board-cards', fromId, query.from?.username || '', { boardId, filter: 'all' });
      if (!res.ok) {
        await bot.editMessageText(`Gagal ambil task board: ${res.data?.error || 'unknown error'}`, { chat_id: chatId, message_id: messageId }).catch(() => {});
        return;
      }
      await bot.editMessageText(formatCardsList(res.data.cards, {
        title: `*Task di ${escMd(res.data.board.name)}*`,
        emptyText: `Tidak ada task terbuka di ${res.data.board.name}.`,
      }), {
        chat_id: chatId,
        message_id: messageId,
        parse_mode: 'Markdown',
        disable_web_page_preview: true,
      }).catch(() => {});
      return;
    }

    if (data.startsWith('muvview:org-overdue:')) {
      const orgId = data.replace('muvview:org-overdue:', '');
      const res = await getMuvCommand('org-overdue', fromId, query.from?.username || '', { orgId });
      if (!res.ok) {
        await bot.editMessageText(`Gagal ambil overdue org: ${res.data?.error || 'unknown error'}`, { chat_id: chatId, message_id: messageId }).catch(() => {});
        return;
      }
      await bot.editMessageText(formatCardsList(res.data.cards, {
        title: `*Overdue ${escMd(res.data.org?.name || 'Organisasi')}*`,
        emptyText: `Tidak ada task overdue di ${res.data.org?.name || 'organisasi ini'}.`,
      }), {
        chat_id: chatId,
        message_id: messageId,
        parse_mode: 'Markdown',
        disable_web_page_preview: true,
      }).catch(() => {});
      return;
    }
  }

  if (data.startsWith('muvcmd:')) {
    const actionSession = getActionSession(chatId, fromId);

    if (data === 'muvcmd:cancel') {
      clearActionSession(chatId, fromId);
      await bot.answerCallbackQuery(query.id).catch(() => {});
      await bot.editMessageText('❎ Aksi dibatalkan.', { chat_id: chatId, message_id: messageId }).catch(() => {});
      return;
    }

    if (data === 'muvcmd:notif:on' || data === 'muvcmd:notif:off') {
      const enabled = data.endsWith(':on');
      const res = await postMuvAction('notif', fromId, query.from?.username || '', { telegramEnabled: enabled });
      await bot.answerCallbackQuery(query.id).catch(() => {});
      await bot.editMessageText(
        res.ok ? `✅ Notif Telegram sekarang ${enabled ? 'aktif' : 'mati'} untuk semua membership kamu.` : 'Gagal update notif Telegram.',
        { chat_id: chatId, message_id: messageId }
      ).catch(() => {});
      return;
    }

    if (!actionSession) {
      await bot.answerCallbackQuery(query.id, { text: 'Sesi aksi sudah habis' }).catch(() => {});
      return;
    }

    const runCardAction = async (action, cardId, extra = {}) => {
      const res = await postMuvAction(action, fromId, query.from?.username || '', { cardId, ...extra });
      await bot.answerCallbackQuery(query.id).catch(() => {});
      if (!res.ok) {
        await bot.editMessageText(`Gagal: ${res.data?.error || 'unknown error'}`, {
          chat_id: chatId,
          message_id: messageId,
        }).catch(() => {});
        clearActionSession(chatId, fromId);
        return true;
      }
      return res;
    };

    if (data.startsWith('muvcmd:done-card:')) {
      const cardId = data.replace('muvcmd:done-card:', '');
      const res = await runCardAction('done', cardId);
      if (res === true) return;
      clearActionSession(chatId, fromId);
      await bot.editMessageText(`✅ Task dipindah ke ${res.data.card.listName}\n\n${res.data.card.title}\n${res.data.card.url}`, {
        chat_id: chatId,
        message_id: messageId,
        disable_web_page_preview: true,
      }).catch(() => {});
      return;
    }

    if (data.startsWith('muvcmd:watch-card:')) {
      const cardId = data.replace('muvcmd:watch-card:', '');
      const res = await runCardAction('watch', cardId);
      if (res === true) return;
      clearActionSession(chatId, fromId);
      await bot.editMessageText(`✅ Sekarang kamu watch task ini:\n\n${res.data.card.title}\n${res.data.card.url}`, {
        chat_id: chatId,
        message_id: messageId,
        disable_web_page_preview: true,
      }).catch(() => {});
      return;
    }

    if (data.startsWith('muvcmd:unwatch-card:')) {
      const cardId = data.replace('muvcmd:unwatch-card:', '');
      const res = await runCardAction('unwatch', cardId);
      if (res === true) return;
      clearActionSession(chatId, fromId);
      await bot.editMessageText(`✅ Task ini sudah di-unwatch:\n\n${res.data.card.title}\n${res.data.card.url}`, {
        chat_id: chatId,
        message_id: messageId,
        disable_web_page_preview: true,
      }).catch(() => {});
      return;
    }

    if (data.startsWith('muvcmd:move-card:') || data.startsWith('muvcmd:assign-card:') || data.startsWith('muvcmd:due-card:')) {
      const [prefix, cardId] = data.startsWith('muvcmd:move-card:')
        ? ['move', data.replace('muvcmd:move-card:', '')]
        : data.startsWith('muvcmd:assign-card:')
          ? ['assign', data.replace('muvcmd:assign-card:', '')]
          : ['due', data.replace('muvcmd:due-card:', '')];

      const ctx = await getMuvCommand('card-context', fromId, query.from?.username || '', { cardId });
      if (!ctx.ok) {
        await bot.answerCallbackQuery(query.id).catch(() => {});
        await bot.editMessageText(`Gagal ambil konteks card: ${ctx.data?.error || 'unknown error'}`, {
          chat_id: chatId,
          message_id: messageId,
        }).catch(() => {});
        clearActionSession(chatId, fromId);
        return;
      }

      if (prefix === 'move') {
        setActionSession(chatId, fromId, { ...actionSession, action: 'move', card: ctx.data.card });
        await bot.answerCallbackQuery(query.id).catch(() => {});
        await bot.editMessageText(`Pilih list tujuan untuk:\n${ctx.data.card.title}`, {
          chat_id: chatId,
          message_id: messageId,
          reply_markup: {
            inline_keyboard: [
              ...chunkButtons(ctx.data.card.lists.map(list => ({ text: list.name, callback_data: `muvcmd:move-list:${list.id}` })), 2),
              [{ text: 'Batal', callback_data: 'muvcmd:cancel' }],
            ],
          },
        }).catch(() => {});
        return;
      }

      if (prefix === 'assign') {
        setActionSession(chatId, fromId, { ...actionSession, action: 'assign', card: ctx.data.card });
        await bot.answerCallbackQuery(query.id).catch(() => {});
        await bot.editMessageText(`Pilih assignee untuk:\n${ctx.data.card.title}`, {
          chat_id: chatId,
          message_id: messageId,
          reply_markup: {
            inline_keyboard: [
              ...chunkButtons(ctx.data.card.members.slice(0, 20).map(member => ({
                text: truncateLabel(member.name || member.email, 28),
                callback_data: `muvcmd:assign-member:${member.id}`,
              })), 2),
              [{ text: 'Batal', callback_data: 'muvcmd:cancel' }],
            ],
          },
        }).catch(() => {});
        return;
      }

      setActionSession(chatId, fromId, { ...actionSession, action: 'due', card: ctx.data.card });
      await bot.answerCallbackQuery(query.id).catch(() => {});
      await bot.editMessageText(`Pilih due date untuk:\n${ctx.data.card.title}`, {
        chat_id: chatId,
        message_id: messageId,
        reply_markup: {
          inline_keyboard: [
            ...chunkButtons([
              { text: 'Hari ini 17:00', callback_data: 'muvcmd:due-set:today-17' },
              { text: 'Besok 09:00', callback_data: 'muvcmd:due-set:tomorrow-09' },
              { text: 'Besok 17:00', callback_data: 'muvcmd:due-set:tomorrow-17' },
              { text: 'Hapus due', callback_data: 'muvcmd:due-set:none' },
            ], 2),
            [{ text: 'Batal', callback_data: 'muvcmd:cancel' }],
          ],
        },
      }).catch(() => {});
      return;
    }

    if (data.startsWith('muvcmd:move-list:')) {
      const cardId = actionSession.card?.id;
      const targetListId = data.replace('muvcmd:move-list:', '');
      if (!cardId || !targetListId) {
        await bot.answerCallbackQuery(query.id, { text: 'Sesi move sudah habis' }).catch(() => {});
        clearActionSession(chatId, fromId);
        return;
      }
      const res = await runCardAction('move', cardId, { listId: targetListId });
      if (res === true) return;
      clearActionSession(chatId, fromId);
      await bot.editMessageText(`✅ Task dipindah ke ${res.data.card.listName}\n\n${res.data.card.title}\n${res.data.card.url}`, {
        chat_id: chatId,
        message_id: messageId,
        disable_web_page_preview: true,
      }).catch(() => {});
      return;
    }

    if (data.startsWith('muvcmd:assign-member:')) {
      const cardId = actionSession.card?.id;
      const assigneeId = data.replace('muvcmd:assign-member:', '');
      if (!cardId || !assigneeId) {
        await bot.answerCallbackQuery(query.id, { text: 'Sesi assign sudah habis' }).catch(() => {});
        clearActionSession(chatId, fromId);
        return;
      }
      const res = await runCardAction('assign', cardId, { assigneeId });
      if (res === true) return;
      clearActionSession(chatId, fromId);
      const who = res.data.assignee.name || res.data.assignee.email;
      await bot.editMessageText(`✅ Task di-assign ke ${who}\n\n${res.data.card.title}\n${res.data.card.url}`, {
        chat_id: chatId,
        message_id: messageId,
        disable_web_page_preview: true,
      }).catch(() => {});
      return;
    }

    if (data.startsWith('muvcmd:due-set:')) {
      const cardId = actionSession.card?.id;
      const preset = data.replace('muvcmd:due-set:', '');
      if (!cardId || !preset) {
        await bot.answerCallbackQuery(query.id, { text: 'Sesi due sudah habis' }).catch(() => {});
        clearActionSession(chatId, fromId);
        return;
      }
      const res = await runCardAction('due', cardId, { dueDate: duePresetToIso(preset) });
      if (res === true) return;
      clearActionSession(chatId, fromId);
      const dueLine = res.data.card.dueDate ? `⏰ ${formatDueLabel(res.data.card.dueDate)}` : 'Tanpa due date';
      await bot.editMessageText(`✅ Due date diupdate\n\n${res.data.card.title}\n${dueLine}\n${res.data.card.url}`, {
        chat_id: chatId,
        message_id: messageId,
        disable_web_page_preview: true,
      }).catch(() => {});
      return;
    }
  }

  if (!data.startsWith('muv:')) return;

  const session = getNewTaskSession(chatId, fromId);
  if (!session) {
    await bot.answerCallbackQuery(query.id, { text: 'Sesi /new sudah habis' }).catch(() => {});
    return;
  }

  if (data === 'muv:cancel') {
    clearNewTaskSession(chatId, fromId);
    await bot.answerCallbackQuery(query.id).catch(() => {});
    await bot.editMessageText('❎ Pembuatan task dibatalkan.', {
      chat_id: chatId,
      message_id: messageId,
    }).catch(() => {});
    return;
  }

  if (data.startsWith('muv:org:')) {
    const orgId = data.replace('muv:org:', '');
    const org = session.orgs?.find(item => item.id === orgId);
    if (!org) {
      await bot.answerCallbackQuery(query.id, { text: 'Organisasi tidak ditemukan' }).catch(() => {});
      return;
    }

    const scoped = await getMuvBoards(fromId, query.from?.username || '', { orgId });
    const boards = scoped.data?.boards || [];
    if (!scoped.ok || !boards.length) {
      await bot.answerCallbackQuery(query.id).catch(() => {});
      await bot.editMessageText(`Belum ada board aktif di ${org.name} buat bikin task.`, {
        chat_id: chatId,
        message_id: messageId,
      }).catch(() => {});
      clearNewTaskSession(chatId, fromId);
      return;
    }

    setNewTaskSession(chatId, fromId, {
      ...session,
      selectedOrgId: orgId,
      orgName: org.name,
      boards,
      stage: 'pick-board',
    });

    await bot.answerCallbackQuery(query.id).catch(() => {});
    await bot.editMessageText(`Pilih board di ${org.name}:`, {
      chat_id: chatId,
      message_id: messageId,
      reply_markup: {
        inline_keyboard: [
          ...chunkButtons(
            boards.map(board => ({ text: board.name, callback_data: `muv:board:${board.id}` })),
            2
          ),
          [{ text: 'Batal', callback_data: 'muv:cancel' }],
        ],
      },
    }).catch(() => {});
    return;
  }

  if (data.startsWith('muv:board:')) {
    const boardId = data.replace('muv:board:', '');
    const board = session.boards?.find(item => item.id === boardId);
    if (!board) {
      await bot.answerCallbackQuery(query.id, { text: 'Board tidak ditemukan' }).catch(() => {});
      return;
    }

    setNewTaskSession(chatId, fromId, {
      ...session,
      boardId,
      boardName: board.name,
      lists: board.lists || [],
      stage: 'pick-list',
    });

    await bot.answerCallbackQuery(query.id).catch(() => {});
    await bot.editMessageText(`Pilih list untuk board: ${board.name}`, {
      chat_id: chatId,
      message_id: messageId,
      reply_markup: {
        inline_keyboard: [
          ...chunkButtons(
            (board.lists || []).map(list => ({ text: list.name, callback_data: `muv:list:${list.id}` })),
            2
          ),
          [{ text: 'Batal', callback_data: 'muv:cancel' }],
        ],
      },
    }).catch(() => {});
    return;
  }

  if (data.startsWith('muv:list:')) {
    const listId = data.replace('muv:list:', '');
    const list = session.lists?.find(item => item.id === listId);
    if (!list) {
      await bot.answerCallbackQuery(query.id, { text: 'List tidak ditemukan' }).catch(() => {});
      return;
    }

    setNewTaskSession(chatId, fromId, {
      ...session,
      listId,
      listName: list.name,
      stage: 'await-title',
    });

    await bot.answerCallbackQuery(query.id).catch(() => {});
    await bot.editMessageText(
      `Board: ${session.boardName}\nList: ${list.name}\n\nSekarang kirim judul task.\nKetik "batal" kalau jadi batal.`,
      {
        chat_id: chatId,
        message_id: messageId,
      }
    ).catch(() => {});
    return;
  }

  if (data.startsWith('muv:due:')) {
    if (session.stage !== 'pick-due' || !session.title || !session.listId) {
      await bot.answerCallbackQuery(query.id, { text: 'Sesi tidak valid' }).catch(() => {});
      return;
    }

    const duePreset = data.replace('muv:due:', '');
    const dueDate = duePresetToIso(duePreset);
    const createRes = await createMuvCard({
      fromId,
      username: query.from?.username || '',
      listId: session.listId,
      title: session.title,
      dueDate,
    });

    if (!createRes.ok) {
      const errorText = createRes.data?.error ? `Task belum berhasil dibuat: ${createRes.data.error}` : 'Task belum berhasil dibuat. Coba /new lagi sebentar.';
      clearNewTaskSession(chatId, fromId);
      await bot.answerCallbackQuery(query.id, { text: 'Gagal bikin task' }).catch(() => {});
      await bot.editMessageText(errorText, {
        chat_id: chatId,
        message_id: messageId,
      }).catch(() => {});
      return;
    }

    clearNewTaskSession(chatId, fromId);
    const card = createRes.data.card;
    const dueLine = card?.dueDate ? `\n⏰ ${formatDueLabel(card.dueDate)}` : '';
    await bot.answerCallbackQuery(query.id).catch(() => {});
    await bot.editMessageText(
      `✅ Task dibuat di ${card.boardName} → ${card.listName}\n\n${card.title}${dueLine}\n${card.url}`,
      {
        chat_id: chatId,
        message_id: messageId,
        disable_web_page_preview: true,
      }
    ).catch(() => {});
  }
});

// ─── File extraction helpers ──────────────────────────────────────────────────
async function downloadFile(fileId) {
  const fileInfo = await bot.getFile(fileId);
  const url = `https://api.telegram.org/file/bot${BOT_TOKEN}/${fileInfo.file_path}`;
  const res = await fetch(url);
  if (!res.ok) throw new Error(`Download failed: ${res.status}`);
  return Buffer.from(await res.arrayBuffer());
}

async function extractFileContent(msg) {
  const isPhoto = !!msg.photo;
  const doc  = msg.document;
  const mime = doc?.mime_type || '';
  const caption = (msg.caption || '').trim();

  if (isPhoto || mime.startsWith('image/')) {
    const fileId = isPhoto ? msg.photo[msg.photo.length - 1].file_id : doc.file_id;
    const buf = await downloadFile(fileId);
    const mediaType = isPhoto ? 'image/jpeg' : (mime || 'image/jpeg');
    return { type: 'image', base64: buf.toString('base64'), mediaType, caption };
  }

  if (mime === 'application/pdf') {
    const buf  = await downloadFile(doc.file_id);
    const data = await pdfParse(buf);
    return { type: 'text', content: `[File PDF: ${doc.file_name}]\n\n${data.text.slice(0, 12000)}`, caption };
  }

  if (mime === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') {
    const buf    = await downloadFile(doc.file_id);
    const result = await mammoth.extractRawText({ buffer: buf });
    return { type: 'text', content: `[File DOCX: ${doc.file_name}]\n\n${result.value.slice(0, 12000)}`, caption };
  }

  if (mime.startsWith('text/') || ['application/json', 'text/csv', 'text/markdown'].includes(mime)
      || /\.(txt|csv|json|md|yaml|yml|xml)$/i.test(doc.file_name || '')) {
    const buf  = await downloadFile(doc.file_id);
    return { type: 'text', content: `[File: ${doc.file_name}]\n\n${buf.toString('utf-8').slice(0, 12000)}`, caption };
  }

  return null;
}

// ─── Main listener ────────────────────────────────────────────────────────────
bot.on("message", async (msg) => {
  console.log("[msg]", msg.chat.id, msg.chat.type, msg.text?.slice(0,50));
  console.log("[msg]", msg.chat.id, msg.chat.type, msg.text?.slice(0,40));
  const chatId   = msg.chat.id;
  const text     = msg.text?.trim();
  const chatType = msg.chat.type;
  const fromId   = msg.from?.id;
  const fromName = msg.from?.first_name || msg.from?.username || 'Seseorang';

  if (text && text.startsWith('/')) return;

  // ─── File handler ───
  const hasFile = !!msg.photo || !!msg.document;
  if (hasFile) {
    if (paused && !isAdmin(fromId)) { console.log('[msg] blocked: paused'); return; }
    if (chatType === 'private' && !isAllowedUser(fromId)) { console.log('[msg] blocked: private not allowed'); return; }
    if ((chatType === 'group' || chatType === 'supergroup') && !isAllowedGroup(chatId)) { console.log('[msg] blocked: group ' + chatId + ' not in allowedGroupIds'); return; }
    if ((chatType === 'group' || chatType === 'supergroup') && !loudGroups.has(chatId)) {
      const caption     = msg.caption || '';
      const isMentioned = BOT_USERNAME && caption.includes(`@${BOT_USERNAME}`);
      const isReply     = msg.reply_to_message?.from?.id === botInfo?.id;
      if (!isMentioned && !isReply) { console.log('[msg] blocked: file no mention/reply'); return; }
    }
    if (processing.has(chatId)) { console.log('[msg] blocked: processing (file)'); return; }

    await bot.sendChatAction(chatId, 'typing').catch(() => {});
    let extracted;
    try {
      extracted = await extractFileContent(msg);
    } catch (e) {
      await bot.sendMessage(chatId, `Gagal baca file: ${e.message}`, { reply_to_message_id: msg.message_id });
      return;
    }
    if (!extracted) {
      await bot.sendMessage(chatId, 'Format file ini belum didukung. Yang bisa gue baca: gambar, PDF, DOCX, TXT, CSV, JSON.', {
        reply_to_message_id: msg.message_id,
      });
      return;
    }

    const instruction = extracted.caption || 'Baca dan ringkas isi file ini.';
    let userContent;
    if (extracted.type === 'image') {
      userContent = [
        { type: 'image', source: { type: 'base64', media_type: extracted.mediaType, data: extracted.base64 } },
        { type: 'text', text: `[${fromName}]: ${instruction}` },
      ];
    } else {
      userContent = `[${fromName}]: ${instruction}\n\n${extracted.content}`;
    }
    await handleMessage(chatId, userContent, msg.message_id, fromId).catch(console.error);
    return;
  }

  // ─── Text handler ───
  if (!text) return;
  if (paused && !isAdmin(fromId)) { console.log('[msg] blocked: paused'); return; }

  const taskSession = getNewTaskSession(chatId, fromId);
  if (taskSession?.stage === 'await-title') {
    if (text.toLowerCase() === 'batal') {
      clearNewTaskSession(chatId, fromId);
      await bot.sendMessage(chatId, '❎ Pembuatan task dibatalkan.', { reply_to_message_id: msg.message_id }).catch(() => {});
      return;
    }

    setNewTaskSession(chatId, fromId, {
      ...taskSession,
      title: text.slice(0, 180).trim(),
      stage: 'pick-due',
    });

    await bot.sendMessage(chatId, 'Pilih due date:', {
      reply_markup: {
        inline_keyboard: [
          ...chunkButtons([
            { text: 'Hari ini 17:00', callback_data: 'muv:due:today-17' },
            { text: 'Besok 09:00', callback_data: 'muv:due:tomorrow-09' },
            { text: 'Besok 17:00', callback_data: 'muv:due:tomorrow-17' },
            { text: 'Tanpa due', callback_data: 'muv:due:none' },
          ], 2),
          [{ text: 'Batal', callback_data: 'muv:cancel' }],
        ],
      },
    }).catch(() => {});
    return;
  }

  if (/^bisa baca muv\??$/i.test(text)) {
    await bot.sendMessage(chatId, 'Bisa. Sekarang gue bisa bantu bikin task ke MUV lewat /new. Kalau mau diskusi lanjutan soal task atau ide, tinggal chat biasa.', {
      reply_to_message_id: msg.message_id,
    }).catch(() => {});
    return;
  }

  if (chatType === 'private') {
    if (!isAllowedUser(fromId) && !isAdmin(fromId)) { console.log('[msg] blocked: private not allowed'); return; }
    if (fromId && !notifiedUsers.has(fromId) && !isAdmin(fromId)) {
      notifiedUsers.add(fromId);
      notifyAdmin(msg);
    }
    await handleMessage(chatId, text, msg.message_id, fromId).catch(console.error);
    return;
  }

  if (chatType === 'group' || chatType === 'supergroup') {
    if (!isAllowedGroup(chatId)) { console.log('[msg] blocked: group ' + chatId + ' not in allowedGroupIds'); return; }

    const myUsername  = BOT_USERNAME ? `@${BOT_USERNAME}`.toLowerCase() : null;
    const isMentioned = myUsername && text.toLowerCase().includes(myUsername);
    const isReply     = msg.reply_to_message?.from?.id === botInfo?.id;

    // Skip kalau pesan mention bot lain tapi bukan gue
    const otherBotMentions = (text.match(/@\w+/g) || [])
      .filter(m => /bot|care/i.test(m) && myUsername && m.toLowerCase() !== myUsername);
    if (otherBotMentions.length > 0 && !isMentioned && !isReply) { console.log('[msg] blocked: other bot mention'); return; }

    if (!loudGroups.has(chatId)) {
      const triggered = isTriggerKeyword(text);
      if (!isMentioned && !isReply && !triggered) { console.log('[msg] skipped: no mention/reply/trigger'); return; }
    }

    if (processing.has(chatId)) { console.log('[msg] blocked: processing'); return; }

    console.log('[msg] handling: mentioned=' + isMentioned + ' reply=' + isReply);
    const cleanText = text.replace(new RegExp(`@${BOT_USERNAME}`, 'gi'), '').trim();
    await handleMessage(chatId, `[${fromName}]: ${cleanText || text}`, msg.message_id, fromId).catch(console.error);
  }
});

bot.on('polling_error', (err) => {
  if (err.message.includes('409')) return;
  if (err.message.includes('EFATAL')) {
    console.error('[polling] EFATAL — exiting for Docker restart');
    process.exit(1);
  }
  console.error('[polling_error]', err.message);
});

