function taskSessionKey(chatId, userId) {
  return `${chatId}:${userId}`;
}

function setNewTaskSession(chatId, userId, value) {
  newTaskSessions.set(taskSessionKey(chatId, userId), { ...value, updatedAt: Date.now() });
}

function getNewTaskSession(chatId, userId) {
  const key = taskSessionKey(chatId, userId);
  const session = newTaskSessions.get(key);
  if (!session) return null;
  if (Date.now() - session.updatedAt > 15 * 60 * 1000) {
    newTaskSessions.delete(key);
    return null;
  }
  return session;
}

function clearNewTaskSession(chatId, userId) {
  newTaskSessions.delete(taskSessionKey(chatId, userId));
}

